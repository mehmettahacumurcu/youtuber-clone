<UserControl x:Class="YouTuber.Launcher.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid Background="#111318">
    <wv:WebView2 x:Name="Studio" IsHitTestVisible="False" AllowExternalDrop="False"/>
    <Border x:Name="NativeStatus" Background="#111318" Padding="32">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Text="YouTuber Studio" Foreground="White" FontSize="28" HorizontalAlignment="Center"/>
        <TextBlock Margin="0,14,0,0" Text="{Binding StatusMessage}" Foreground="#D8D8D8" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.Name="Studio status"/>
      </StackPanel>
    </Border>
    <StackPanel Panel.ZIndex="2" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="360">
      <Button HorizontalAlignment="Right" Padding="12,5" Content="Open in browser" Command="{Binding OpenInBrowserCommand}" AutomationProperties.Name="Open Studio with a one-time local link"/>
      <TextBlock Margin="0,5,0,0" Text="{Binding BrowserWarning}" Foreground="#FFCE73" Background="#CC111318" TextWrapping="Wrap" TextAlignment="Right"/>
      <TextBlock Margin="0,5,0,0" Text="{Binding BrowserStatusMessage}" Foreground="#FF8C8C" Background="#CC111318" TextWrapping="Wrap" TextAlignment="Right" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
  </Grid>
</UserControl>
