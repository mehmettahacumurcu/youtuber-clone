<UserControl x:Class="YouTuber.Launcher.Views.DataRootSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#111318">
    <Border MaxWidth="680"
            Margin="32"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1B1F27"
            CornerRadius="12">
      <StackPanel>
        <TextBlock Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Text="Choose YouTuber Studio data storage" />
        <TextBlock Margin="0,12,0,22"
                   Foreground="#C8CDD8"
                   TextWrapping="Wrap"
                   Text="Models, transcripts, generated audio, and local service data are stored here. You can choose another local NTFS folder." />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox MinWidth="460"
                   Padding="10,7"
                   VerticalContentAlignment="Center"
                   Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1"
                  Margin="10,0,0,0"
                  Padding="18,8"
                  Command="{Binding BrowseCommand}"
                  Content="Browse…" />
        </Grid>
        <TextBlock MinHeight="20"
                   Margin="0,10,0,0"
                   Foreground="#FF8F8F"
                   Text="{Binding Error}"
                   TextWrapping="Wrap" />
        <Button Margin="0,20,0,0"
                Padding="22,10"
                HorizontalAlignment="Right"
                Command="{Binding ContinueCommand}"
                Content="Continue" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
