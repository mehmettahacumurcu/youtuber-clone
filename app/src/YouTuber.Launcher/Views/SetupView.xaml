<UserControl x:Class="YouTuber.Launcher.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YouTuber.Launcher.Views">
  <StackPanel Margin="24" KeyboardNavigation.TabNavigation="Local">
    <TextBlock Text="First-run setup" FontSize="24" AutomationProperties.HeadingLevel="Level1"/>
    <TextBlock Margin="0,8,0,0" Text="{Binding Stage, StringFormat=Current step: {0}}" AutomationProperties.Name="Current setup step"/>
    <TextBlock Margin="0,8,0,12" Text="{Binding Error}" AutomationProperties.Name="Actionable setup error" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding Components}">
      <ItemsControl.ItemTemplate><DataTemplate><views:ComponentProgressRow/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
      <Button Content="Accept terms" Click="AcceptTerms_Click" IsEnabled="{Binding CanAcceptTerms}" AutomationProperties.Name="Accept setup terms"/>
      <Button Margin="8,0,0,0" Content="Continue setup" Click="Continue_Click" AutomationProperties.Name="Continue first-run setup"/>
      <Button Margin="8,0,0,0" Content="Retry setup" Click="Retry_Click" AutomationProperties.Name="Retry first-run setup"/>
      <Button Margin="8,0,0,0" Content="Close safely" Click="CloseSafely_Click" AutomationProperties.Name="Close setup safely"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
